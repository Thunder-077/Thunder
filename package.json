{
  "name": "thunder",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "pnpm --filter @thunder/api dev",
    "dev:web": "pnpm --filter @thunder/web dev",
    "dev:desktop": "pnpm --filter @thunder/desktop exec tauri dev",
    "build:web": "pnpm --filter @thunder/web build",
    "build:desktop": "pnpm --filter @thunder/desktop build:release",
    "dev:api:cf": "pnpm --filter @thunder/api dev:cf",
    "preview:web:cf": "pnpm --filter @thunder/web preview:cf",
    "deploy:api:cf": "pnpm --filter @thunder/api deploy:cf",
    "deploy:web:cf": "pnpm --filter @thunder/web deploy:cf",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test:plugins": "pnpm --filter @thunder/api test:plugins",
    "test:desktop-runtime": "node scripts/generate-enabled-modules.test.mjs && node apps/api/scripts/runtime-dependency-utils.test.mjs && node apps/api/scripts/build-desktop-bundle.test.mjs && node packages/database/src/client-platform.test.mjs && node apps/api/src/db-init-paths.test.mjs && node apps/desktop/scripts/runtime-copy-utils.test.mjs && node apps/desktop/scripts/prepare-release-config.test.mjs && node apps/desktop/scripts/build-release.test.mjs",
    "build:plugin:teleprompter": "pnpm --filter @thunder/web build:plugin:teleprompter",
    "build:plugin-marketplace": "pnpm --filter @thunder/api build:plugin-marketplace",
    "plugin:create": "pnpm --dir packages/plugin-cli exec tsx src/index.ts create",
    "version:set": "node ./scripts/set-desktop-version.mjs",
    "version:check": "node ./scripts/check-desktop-version.mjs",
    "db:generate": "pnpm --filter @thunder/database db:generate",
    "db:generate:postgres": "pnpm --filter @thunder/database db:generate:postgres",
    "db:generate:sqlite": "pnpm --filter @thunder/database db:generate:sqlite",
    "db:compile-sqlite-migrations": "pnpm --filter @thunder/database db:compile-sqlite-migrations",
    "db:migrate": "pnpm --filter @thunder/database db:migrate",
    "db:migrate:sqlite": "pnpm --filter @thunder/database db:migrate:sqlite",
    "db:push": "pnpm --filter @thunder/database db:push",
    "db:studio": "pnpm --filter @thunder/database db:studio"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "turbo": "^2.9.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "skia-canvas"
    ]
  }
}

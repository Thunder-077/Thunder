{
  "manifestVersion": 2,
  "id": "hello-plugin",
  "name": "Hello Plugin",
  "version": "1.0.0",
  "description": "A minimal Thunder desktop plugin example.",
  "kind": "trusted",
  "engines": {
    "thunder": "^2.0.0"
  },
  "author": {
    "name": "Thunder"
  },
  "icon": "Package",
  "permissions": ["storage", "notifications"],
  "contributes": {
    "sidebar": {
      "title": "Hello Plugin",
      "icon": "Package",
      "entry": "dist/index.html"
    }
  },
  "runtime": {
    "entry": "dist/worker.js"
  }
}

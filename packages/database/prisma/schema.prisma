datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

model AppModule {
  id           String  @id
  name         String
  enabled      Boolean @default(true)
  settingsJson String?
  createdAt    String  @map("created_at")
  updatedAt    String  @map("updated_at")

  @@map("app_modules")
}

model AppSetting {
  key       String @id
  valueJson String @map("value_json")
  createdAt String @map("created_at")
  updatedAt String @map("updated_at")

  @@map("app_settings")
}

model AuthUser {
  id            String  @id
  username      String  @unique
  passwordHash  String  @map("password_hash")
  passwordSalt  String  @map("password_salt")
  avatarDataUrl String? @map("avatar_data_url")
  createdAt     String  @map("created_at")
  updatedAt     String  @map("updated_at")

  @@map("auth_user")
}

model EmbyPlaylistRecord {
  slug              String @id
  name              String
  description       String
  cover             String
  tagsJson          String @map("tags_json")
  point             Int
  isPublic          Boolean @map("is_public")
  isShowEmpty       Boolean @map("is_show_empty")
  enabled           Boolean
  limit             Int
  releaseWindowDays Int    @map("release_window_days")
  remoteWatchId     Int?   @map("remote_watch_id")
  createdAt         String @map("created_at")
  updatedAt         String @map("updated_at")

  @@map("emby_playlist")
}

model EmbyWatchCacheRecord {
  slug        String @id
  feedJson    String @map("feed_json")
  count       Int
  generatedAt String @map("generated_at")
  createdAt   String @map("created_at")
  updatedAt   String @map("updated_at")

  @@map("emby_watch_cache")
}

model EmbyWatchRefreshTaskRecord {
  slug         String  @id
  status       String
  stateJson    String  @map("state_json")
  errorMessage String? @map("error_message")
  createdAt    String  @map("created_at")
  updatedAt    String  @map("updated_at")

  @@map("emby_watch_refresh_task")
}

model VaultMetadata {
  id                   String  @id
  kdfJson              String  @map("kdf_json")
  encryptedDataKeyJson String  @map("encrypted_data_key_json")
  passwordHint         String? @map("password_hint")
  createdAt            String  @map("created_at")
  updatedAt            String  @map("updated_at")

  @@map("vault_metadata")
}

model VaultItem {
  id                   String @id
  vaultId              String @map("vault_id")
  encryptedPayloadJson String @map("encrypted_payload_json")
  createdAt            String @map("created_at")
  updatedAt            String @map("updated_at")

  @@index([vaultId])
  @@map("vault_items")
}

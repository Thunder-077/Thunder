{
  "name": "@thunder/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "workerd": "./src/index.postgres.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "db:generate": "pnpm run db:generate:postgres && pnpm run db:generate:sqlite && pnpm run db:compile-sqlite-migrations",
    "db:generate:postgres": "prisma generate --schema=prisma/schema.prisma",
    "db:generate:sqlite": "node scripts/sync-sqlite-schema.mjs && prisma generate --schema=prisma/schema.sqlite.prisma",
    "db:compile-sqlite-migrations": "node scripts/compile-migrations.mjs",
    "db:migrate": "prisma migrate dev",
    "db:migrate:sqlite": "node scripts/sync-sqlite-schema.mjs && node scripts/create-sqlite-migration.mjs",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-neon": "^6.19.0",
    "@prisma/client": "^6.7.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "prisma": "^6.7.0",
    "typescript": "^5"
  }
}

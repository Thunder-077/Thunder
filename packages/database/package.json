{
  "name": "@thunder/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate --schema=prisma/schema.prisma && node scripts/sync-sqlite-schema.mjs && prisma generate --schema=prisma/schema.sqlite.prisma && node scripts/compile-migrations.mjs",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-neon": "^6.19.0",
    "@prisma/client": "^6.7.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "prisma": "^6.7.0",
    "typescript": "^5"
  }
}

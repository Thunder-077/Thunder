{
  "name": "@thunder/plugin-cli",
  "version": "0.1.0",
  "description": "Command line toolkit for creating, developing, validating, and packaging Thunder desktop plugins.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "thunder-plugin": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@thunder/plugin-sdk": "workspace:*",
    "@thunder/plugin-schema": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "esbuild": "^0.28.0",
    "postcss": "^8.5.15",
    "tar": "^7.5.15"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-templates.mjs",
    "test": "tsx src/index.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}

{
  "name": "@thunder/plugin-sdk",
  "version": "0.1.0",
  "description": "Browser and worker SDK for Thunder desktop plugins.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@thunder/plugin-protocol": "workspace:*",
    "@thunder/plugin-schema": "workspace:*",
    "@thunder/plugin-sdk-worker": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx src/browser.test.ts",
    "test:browser": "tsx src/browser.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}

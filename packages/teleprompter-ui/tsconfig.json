{
  "compilerOptions": {
    "target": "ES2017",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@thunder/teleprompter-core": ["../teleprompter-core/src/index.ts"],
      "@thunder/ui": ["../ui/src/index.ts"]
    }
  },
  "include": ["src"]
}

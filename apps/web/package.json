{
  "name": "@thunder/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/run-web.mjs dev",
    "build": "node ../../scripts/run-web.mjs build",
    "start": "next start",
    "preview:cf": "node ../../scripts/run-with-generated-modules.mjs -- pnpm --dir apps/web exec opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "node ../../scripts/run-with-generated-modules.mjs -- pnpm --dir apps/web exec opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "build:plugin:teleprompter": "node ./scripts/build-teleprompter-plugin.mjs",
    "test:plugin-bridge": "node ../../scripts/run-with-generated-modules.mjs -- pnpm --dir apps/web exec tsx src/lib/desktop-plugin-bridge.test.ts && pnpm exec tsx src/lib/modules.test.ts",
    "test:teleprompter": "node ../../scripts/run-with-generated-modules.mjs -- pnpm --dir apps/web exec tsx src/modules/teleprompter/utils/follow-engine.test.ts && pnpm exec tsx tests/teleprompter-storage.test.ts && pnpm exec tsx tests/teleprompter-web-speech-transcriber.test.ts",
    "lint": "node ../../scripts/run-with-generated-modules.mjs -- pnpm --dir apps/web exec eslint",
    "lint:css": "stylelint \"**/*.css\"",
    "typecheck": "node ../../scripts/run-with-generated-modules.mjs -- pnpm --dir apps/web exec tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@tauri-apps/api": "^2.11.0",
    "@thunder/api-client": "workspace:*",
    "@thunder/core": "workspace:*",
    "@thunder/plugin-sdk": "workspace:*",
    "@thunder/emby": "workspace:*",
    "@thunder/platform": "workspace:*",
    "@thunder/vault": "workspace:*",
    "argon2-browser": "^1.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "pinyin-pro": "^3.28.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.5.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.9.0",
    "@tailwindcss/postcss": "^4",
    "@types/argon2-browser": "^1.18.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/zxcvbn": "^4.4.5",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "postcss": "^8.5.15",
    "sharp": "^0.34.5",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wrangler": "^4.44.0"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thunder",
  "version": "0.1.1",
  "identifier": "com.thunder.desktop",
  "build": {
    "beforeDevCommand": "node ./scripts/dev-desktop-deps.mjs",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node ./scripts/prepare-release-config.mjs",
    "frontendDist": "../../web/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Thunder",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 720,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/128x128@2x.png",
      "../icons/icon.icns",
      "../icons/icon.ico",
      "../icons/icon.png"
    ]
  }
}

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "thunder-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-05",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  },
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
